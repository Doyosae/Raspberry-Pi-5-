import urllib.request, json, tkinter, tkinter.font # 네트워크 통신, JSON 처리, GUI 구현을 위한 라이브러리 임포트

# 발급받은 OpenWeatherMap 고유 API 키 (서버 인증용)
API_KEY = "890120b1c5ea********************"

def tick1Min():
    # 데이터를 요청할 API 서버의 URL (도시: 서울, 단위: 섭씨온도 설정)
    url = f"https://api.openweathermap.org/data/2.5/weather?q=Seoul&appid={API_KEY}&units=metric"
    
    # 서버에 접속하여 응답 데이터를 읽어옴 (HTTP GET 요청)
    with urllib.request.urlopen(url) as r:
        # 응답받은 JSON 텍스트 데이터를 파이썬 딕셔너리 형태로 변환 (디코딩)
        data = json.loads(r.read())
    
    # 계층 구조를 가진 JSON 데이터에서 실제 기온과 습도 값만 추출
    temp = data["main"]["temp"]
    humi = data["main"]["humidity"]
    
    # 추출된 데이터를 GUI 레이블 위젯의 텍스트로 업데이트
    label.config(text=f"{temp:.1f}C   {humi}%")
    
    # 60,000ms(1분) 후에 자기 자신(tick1Min)을 다시 호출하여 실시간 자동 갱신
    window.after(60000, tick1Min)

# GUI 기본 윈도우 생성 및 초기 설정
window = tkinter.Tk()
window.title("TEMP HUMI DISPLAY") # 창 제목 설정
window.geometry("400x100")        # 창 크기 설정
window.resizable(False, False)    # 창 크기 조절 금지

# 텍스트 가독성을 위한 대형 폰트(크기 30) 설정
font = tkinter.font.Font(size=30)

# 데이터를 표시할 레이블 위젯 생성 및 배치
label = tkinter.Label(window, text="", font=font)
label.pack()

# 최초 1회 함수를 호출하여 데이터 수집 시작
tick1Min()

# 사용자가 창을 닫을 때까지 프로그램의 이벤트 루프 유지
window.mainloop()
