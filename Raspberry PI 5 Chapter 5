from flask import Flask, render_template, request  # 웹 서버 구축 및 데이터 처리를 위한 모듈 호출
from gpiozero import LED  # 라즈베리 파이 GPIO 제어를 위한 라이브러리

app = Flask(__name__)  # Flask 애플리케이션 객체 생성

# GPIO 21번 핀에 연결된 LED 객체 생성
red_led = LED(21)

# 메인 페이지 (브라우저 접속 시 처음 보이는 화면)
@app.route('/')                                   
def home():
    # 'templates' 폴더 안에 있는 index.html 파일을 읽어서 사용자에게 보여줍니다.
    return render_template("index.html")         


# LED 상태 변경을 위한 데이터 수신 경로
@app.route('/data', methods = ['POST'])
def data():
    # HTML의 <form> 태그나 버튼에서 보낸 'led'라는 이름의 데이터를 가져옵니다.
    data = request.form['led']      

    # 데이터 값이 'on'이면 LED를 켭니다.
    if(data == 'on'):           
        red_led.on()
    
    # 데이터 값이 'off'이면 LED를 끕니다.
    elif(data == 'off'):   
        red_led.off()

    # 작업 완료 후 다시 홈(index.html) 화면으로 돌아갑니다.
    return home()

# 서버 실행 설정
if __name__ == "__main__":
    # host = "0.0.0.0" : 같은 네트워크에 있는 다른 기기에서도 접속 가능하게 함
    # port = "80" : 기본 HTTP 포트를 사용 (브라우저 주소창에 포트 번호 생략 가능)
    app.run(host = "0.0.0.0", port = "80")
