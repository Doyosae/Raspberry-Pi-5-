import speech_recognition as sr  # 마이크 음성을 텍스트로 변환하는 STT(Speech-to-Text) 라이브러리
import requests                  # 외부 기상 서버(API)에 날씨 데이터를 요청하기 위한 라이브러리
import os                        # 리눅스 시스템 명령어(espeak)를 실행하기 위한 모듈
import time                      # 시간 지연 제어를 위한 모듈

# [1. 날씨 API 설정] OpenWeatherMap 서버 접속 주소 및 옵션 정의
API_KEY = "Enter your API key here"  # 발급받은 OpenWeatherMap 개인 인증 키
# 서울(Seoul) 지역의 날씨를 섭씨온도(&units=metric) 단위로 요청하는 URL
url = f"https://api.openweathermap.org/data/2.5/weather?q=Seoul&appid={API_KEY}&units=metric"

# [2. 음성 합성(TTS) 함수 정의] 텍스트를 오디오 신호로 변환하여 출력
def speak(option, msg):
    # os.system을 통해 라즈베리 파이 리눅스 셸에서 'espeak 옵션 메시지' 명령어를 호출
    os.system("espeak {} '{}'".format(option, msg))

try:
    # 키보드 인터럽트(Ctrl+C)가 발생할 때까지 상시 대기 상태 유지를 위한 무한 루프
    while True:
        r = sr.Recognizer()  # 외부 소음을 제거하고 음성을 분석하는 Google 음성 인식기 객체 생성
        
        # [3. 음성 수집 및 STT 단계]
        with sr.Microphone() as source:  # 라즈베리 파이에 연결된 USB/기본 마이크를 입력 장치로 지정
            print("Say something!")      # 사용자에게 음성 입력 타이밍을 알림
            audio = r.listen(source)     # 마이크로부터 음성 신호가 들어올 때까지 감지하여 녹음
        
        try:
            # 녹음된 오디오 데이터를 Google 음성 인식 서버로 전송하여 한국어('ko-KR') 텍스트로 변환
            text = r.recognize_google(audio, language='ko-KR')
            print("You said: " + text)   # 텍스트로 인식된 최종 결과 화면 출력
            
            # [4. 조건문 및 API 데이터 가공 단계]
            # 사용자가 말한 문장 안에 "날씨"라는 키워드가 포함되어 있는지 판단 (포함 관계 검사)
            if "날씨" in text:
                print("날씨 음성을 인식하였습니다.")
                
                response = requests.get(url)   # 설정한 URL로 HTTP GET 요청을 보내 날씨 데이터 수신
                data = response.json()         # 수신된 문자열 데이터를 가공하기 쉬운 JSON 객체(딕셔너리)로 파싱
                
                temp = data["main"]["temp"]       # JSON 데이터 구조 내부에서 현재 기온(Celsius) 추출
                humi = data["main"]["humidity"]   # JSON 데이터 구조 내부에서 현재 습도(%) 추출
                
                # 음성으로 출력할 형태의 가독성 있는 안내 문자열(Message) 생성
                msg = '  기온은 ' + str(int(temp)) + '도 습도는 ' + str(humi) + '퍼센트입니다'
                
                # espeak 엔진 옵션 설정 (-s: 말하기 속도 180, -p: 음높이 50, -a: 볼륨 200, -v: 한국어 여성 5번 음성)
                option = '-s 180 -p 50 -a 200 -v ko+f5'
                speak(option, msg)  # 생성된 문장과 옵션을 음성 출력 함수로 전달하여 스피커로 재생
                
        # [5. 예외 처리(Exception Handling)] 음성 인식 과정에서 발생할 수 있는 오류 방어
        except sr.UnknownValueError:
            # 오디오 신호는 감지되었으나 단어나 문장으로 매칭 및 분석을 실패한 경우
            print("Google Speech Recognition could not understand audio")
        except sr.RequestError as e:
            # 인터넷 연결 끊김 등 Google API 웹 서버에 접근할 수 없는 네트워크 에러 발생 시
            print("Could not request results from Google Speech Recognition service; {0}".format(e))

except Keyboard
